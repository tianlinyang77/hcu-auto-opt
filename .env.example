HCUOPT_DATABASE_URL=postgresql://hcuopt:hcuopt@localhost:5432/hcuopt
HCUOPT_API_URL=http://localhost:8000
HCUOPT_AUTO_MIGRATE=true
# Required only for Formal Stage 0 finalization. API and workers must see the same
# deployment-owned evidence tree; leaving it unset keeps Formal finalization disabled.
HCUOPT_STAGE0_EVIDENCE_ROOT=/home/github/hcu-auto-opt/results/stage0
